# systemd user service for the CatchFish server. Assumes the repo is cloned to ~/CatchFish.
# Install: see "Deploying" in Server/README.md.

[Unit]
Description=CatchFish game server

[Service]
# CATCHFISH_DEV_KEY=… turns on the dev API; CATCHFISH_GOOGLE_CLIENT_ID=… and CATCHFISH_GOOGLE_SECRET=…
# turn on Google sign-in. Without the file the server runs with both off.
EnvironmentFile=-%h/.config/catchfish.env
ExecStart=%h/CatchFish/Server/build/catchfish-server --public-url https://fish.thevals.ru:1337
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
